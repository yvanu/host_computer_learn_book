<Window x:Class="HostComputer.IndustrialMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="工业设备监控台 · Modbus TCP 实战" Width="1140" Height="820"
    MinWidth="980" MinHeight="700" Background="#F5F8FC"
    WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#14243B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#748398"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="#E7ECF2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="88"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Window.Resources>
  <Grid Margin="28,22,28,17">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: only real, working actions -->
    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="INDUSTRIAL CONTROL  /  LEARNING LAB" FontSize="11"
                   FontWeight="SemiBold" Foreground="#53789E"/>
        <TextBlock Text="工业设备监控台" Style="{StaticResource PageTitle}"
                   FontSize="29" Margin="0,5,0,2"/>
        <TextBlock Text="Modbus TCP · 单设备采集 · 本地模拟环境"
                   Style="{StaticResource SubtleText}" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="连接设备" Command="{Binding ConnectCommand}"
                Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
        <Button Content="断开连接" Command="{Binding DisconnectCommand}"/>
        <Button Content="导出 CSV" Command="{Binding ExportCommand}" Margin="0"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
        <StackPanel>
          <TextBlock Text="设备概览" FontSize="17" Style="{StaticResource PageTitle}" Margin="0,0,0,22"/>
          <Border Background="#E8F0FF" CornerRadius="9" Padding="12,13" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="●   01 / 本地模拟设备" Foreground="#2563EB" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="127.0.0.1:1502" Foreground="#54708C" Margin="19,7,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
          <TextBlock Text="连接状态" Foreground="#778498" FontSize="12"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,23"
                     FontWeight="SemiBold" Foreground="#233D5D" TextTrimming="None"/>
          <Separator Background="#E7ECF2"/>
          <TextBlock Text="采集配置" Style="{StaticResource PageTitle}" FontSize="14" Margin="0,22,0,12"/>
          <TextBlock Text="协议       Modbus TCP" Foreground="#52657A" FontSize="12" Margin="0,0,0,9"/>
          <TextBlock Text="站号       Unit ID 1" Foreground="#52657A" FontSize="12" Margin="0,0,0,9"/>
          <TextBlock Text="功能码    FC03 (只读)" Foreground="#52657A" FontSize="12" Margin="0,0,0,9"/>
          <TextBlock Text="轮询间隔  1 秒" Foreground="#52657A" FontSize="12" Margin="0,0,0,9"/>
          <TextBlock Text="报警阈值  32.0 ℃" Foreground="#52657A" FontSize="12" Margin="0,0,0,20"/>
          <Separator Background="#E7ECF2"/>
          <TextBlock Text="累计接收帧" Style="{StaticResource SubtleText}" Margin="0,22,0,6"/>
          <TextBlock Text="{Binding SampleCount}" FontSize="31" FontWeight="SemiBold" Foreground="#14243B"/>
          <TextBlock Text="演示用途 · 不连接生产 PLC" Foreground="#A47548"
                     TextWrapping="Wrap" TextTrimming="None" FontSize="11" Margin="0,22,0,0"/>
        </StackPanel>
      </Border>

      <!-- Main content: KPI + actual curve + alarm log -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="18"/>
          <RowDefinition Height="260"/>
          <RowDefinition Height="18"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="温度  /  TEMPERATURE" Foreground="#6B7B91" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding Temperature}" FontSize="34" FontWeight="SemiBold" Foreground="#172B45"/>
                <TextBlock Text=" ℃" Foreground="#657891" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="压力  /  PRESSURE" Foreground="#6B7B91" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding Pressure}" FontSize="34" FontWeight="SemiBold" Foreground="#172B45"/>
                <TextBlock Text=" kPa" Foreground="#657891" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="转速  /  ROTATION" Foreground="#6B7B91" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="{Binding Rpm}" FontSize="34" FontWeight="SemiBold" Foreground="#172B45"/>
                <TextBlock Text=" rpm" Foreground="#657891" FontSize="15" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
              <TextBlock Text="实时温度趋势" Style="{StaticResource PageTitle}" FontSize="17"/>
              <TextBlock Text="最近 60 次采样" DockPanel.Dock="Right" HorizontalAlignment="Right"
                         Style="{StaticResource SubtleText}" FontSize="12"/>
            </DockPanel>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" BorderBrush="#E6EDF5" BorderThickness="0,0,0,1"/>
              <Border Grid.Row="1" BorderBrush="#E6EDF5" BorderThickness="0,0,0,1"/>
              <Border Grid.Row="2" BorderBrush="#E6EDF5" BorderThickness="0,0,0,1"/>
              <Viewbox Grid.RowSpan="3" Stretch="Fill" Margin="0,7,0,3">
                <Canvas Width="900" Height="160">
                  <Polyline Points="{Binding TemperaturePoints}"
                            Stroke="#2970E9" StrokeThickness="3"
                            StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,7,0,0">
              <TextBlock Text="20℃" Foreground="#8897A8" FontSize="11" DockPanel.Dock="Left"/>
              <TextBlock Text="40℃（纵向示意范围）" Foreground="#8897A8" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="报警状态" Style="{StaticResource PageTitle}" FontSize="17"/>
              <Border Background="#FFF3E8" CornerRadius="9" Padding="12" Margin="0,17,0,12">
                <TextBlock Text="{Binding AlarmStatus}" Foreground="#9B5427"
                           TextWrapping="Wrap" TextTrimming="None" FontSize="13"/>
              </Border>
              <TextBlock Text="阈值固定为 32 ℃，仅作模拟教学。" Foreground="#7A8796"
                         TextWrapping="Wrap" TextTrimming="None" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel LastChildFill="True">
              <TextBlock Text="最近事件" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"
                         FontSize="17" Margin="0,0,0,10"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Events}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None"
                                 FontSize="12" Foreground="#576B7F" Margin="0,0,0,9"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Margin="0,17,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding LastUpdated}" Foreground="#65778B" FontSize="12"/>
      <TextBlock Grid.Column="1" Text="{Binding StorageLocation}" Foreground="#8793A4"
                 FontSize="11" ToolTip="{Binding StorageLocation}" MaxWidth="490"/>
    </Grid>
  </Grid>
</Window>
