<Window x:Class="HostComputer.IndustrialMonitor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="上位机实战 · 可交付监控台 v0.5" Width="1190" Height="820"
 MinWidth="980" MinHeight="690" Background="#F5F7FB"
 FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="18"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="#E6EBF2"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#1F314B"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="MinWidth" Value="72"/>
  </Style>
 </Window.Resources>

 <Grid Margin="26,20,26,16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,19">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="INDUSTRIAL MONITOR  /  V0.5 DELIVERY LAB" FontSize="11" Foreground="#3976C8" FontWeight="SemiBold"/>
    <TextBlock Text="多设备工业监控台" FontSize="28" Style="{StaticResource Heading}" Margin="0,5,0,2"/>
    <TextBlock Text="双设备 · 报警确认与审计 · 配置持久化 · 数据保留" Foreground="#6E8297"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="连接选中设备" Command="{Binding ConnectCommand}" Background="#2268D9"
      Foreground="White" BorderBrush="#2268D9"/>
    <Button Content="断开连接" Command="{Binding DisconnectCommand}"/>
    <Button Content="导出 CSV" Command="{Binding ExportCommand}"/>
    <Button Content="清理 30 天前数据" Command="{Binding CleanupCommand}" Margin="0"/>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="18"/>
    <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Grid.Column="0" Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="设备列表" FontSize="17" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
     <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
      BorderThickness="0" Background="Transparent" Height="192">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="5,7">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#20416D"/>
         <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="#78879A" Margin="0,4,0,2"/>
         <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#546E8A"
          TextWrapping="Wrap" Width="190"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>

     <Separator Background="#E6EBF2" Margin="0,17,0,17"/>
     <TextBlock Text="报警阈值设置" FontSize="15" Style="{StaticResource Heading}"/>
     <TextBlock Text="每台独立持久化，20～80 ℃" FontSize="12"
      Foreground="#77889D" Margin="0,7,0,10" TextWrapping="Wrap"/>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="应用" Command="{Binding SaveThresholdCommand}" Margin="8,0,0,0"/>
      <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
       FontSize="15" Padding="10,7"/>
     </DockPanel>
     <TextBlock Text="{Binding SelectedDevice.ThresholdLabel}" Foreground="#637B96"
      Margin="0,10,0,0"/>
     <Button Content="确认最近未确认报警" Command="{Binding AcknowledgeCommand}"
      Margin="0,14,0,0" Padding="10,8"/>
     <Separator Background="#E6EBF2" Margin="0,20,0,18"/>
     <TextBlock Text="连接策略" FontSize="15" Style="{StaticResource Heading}"/>
     <TextBlock Text="读操作：每秒 1 次" Foreground="#63758B" Margin="0,12,0,5"/>
     <TextBlock Text="网络超时：3 秒" Foreground="#63758B" Margin="0,0,0,5"/>
     <TextBlock Text="重连退避：1 / 2 / 4 秒" Foreground="#63758B" Margin="0,0,0,5"/>
     <TextBlock Text="最多 3 次自动重连" Foreground="#63758B" Margin="0,0,0,5"/>
     <TextBlock Text="只读 FC03 · 不控制真机" Foreground="#A45A2F"
      FontSize="12" Margin="0,17,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>

   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="12"/>
     <RowDefinition Height="105"/>
     <RowDefinition Height="12"/>
     <RowDefinition Height="210"/>
     <RowDefinition Height="12"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11">
     <DockPanel>
      <TextBlock Text="{Binding SelectedDevice.Name}" Style="{StaticResource Heading}"
       FontSize="16" DockPanel.Dock="Left"/>
      <TextBlock Text="{Binding SelectedDevice.Status}" Foreground="#276AC7"
       FontWeight="SemiBold" HorizontalAlignment="Right"/>
     </DockPanel>
    </Border>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource Card}">
      <StackPanel><TextBlock Text="实时温度 / ℃" Foreground="#78889A"/>
       <TextBlock Text="{Binding SelectedDevice.Temperature}" FontSize="29"
        FontWeight="SemiBold" Foreground="#183351" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource Card}">
      <StackPanel><TextBlock Text="实时压力 / kPa" Foreground="#78889A"/>
       <TextBlock Text="{Binding SelectedDevice.Pressure}" FontSize="29"
        FontWeight="SemiBold" Foreground="#183351" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource Card}">
      <StackPanel><TextBlock Text="转速 / rpm" Foreground="#78889A"/>
       <TextBlock Text="{Binding SelectedDevice.Rpm}" FontSize="29"
        FontWeight="SemiBold" Foreground="#183351" Margin="0,8,0,0"/></StackPanel>
     </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Card}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
       <TextBlock Text="当前设备 · 温度趋势" Style="{StaticResource Heading}" FontSize="15"/>
       <TextBlock Text="最近 60 次采样" Foreground="#8999AA" HorizontalAlignment="Right"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,12,0,9">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/>
        <RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Grid.Row="0" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
       <Border Grid.Row="1" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
       <Border Grid.Row="2" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1"/>
       <Viewbox Grid.RowSpan="3" Stretch="Fill">
        <Canvas Width="900" Height="160">
         <Polyline Points="{Binding SelectedDevice.TemperaturePoints}"
          Stroke="#2672DB" StrokeThickness="3" StrokeLineJoin="Round"/>
        </Canvas>
       </Viewbox>
      </Grid>
      <DockPanel Grid.Row="2">
       <TextBlock Text="{Binding SelectedDevice.AlarmStatus}" Foreground="#B46B39"
        DockPanel.Dock="Left" FontSize="12"/>
       <TextBlock Text="纵轴示意 20～40 ℃" HorizontalAlignment="Right"
        Foreground="#8A98A8" FontSize="11"/>
      </DockPanel>
     </Grid>
    </Border>

    <Grid Grid.Row="6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Style="{StaticResource Card}">
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="历史采集查询" FontSize="15" Style="{StaticResource Heading}"/>
        <StackPanel Orientation="Horizontal" Margin="0,9,0,6">
         <Button Content="查询历史" Command="{Binding QueryHistoryCommand}"/>
         <Button Content="上一页" Command="{Binding PreviousPageCommand}"/>
         <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="0"/>
        </StackPanel>
        <TextBlock Text="{Binding PageStatus}" Foreground="#718499" FontSize="11"
         TextWrapping="Wrap" Margin="0,0,0,10"/>
       </StackPanel>
       <ListBox ItemsSource="{Binding History}" DisplayMemberPath="Display"
        FontSize="11" BorderThickness="0" Background="Transparent"/>
      </DockPanel>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel LastChildFill="True">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
        <TextBlock Text="设备事件 / 审计" Style="{StaticResource Heading}" FontSize="15" Margin="0,0,12,8"/>
        <Button Content="刷新持久审计" Command="{Binding RefreshAuditCommand}" Padding="8,4"/>
       </StackPanel>
       <TabControl>
        <TabItem Header="当前事件">
         <ListBox ItemsSource="{Binding Events}" FontSize="11" BorderThickness="0"
          Background="Transparent"/>
        </TabItem>
        <TabItem Header="持久审计">
         <ListBox ItemsSource="{Binding Audit}" FontSize="11" BorderThickness="0"
          Background="Transparent"/>
        </TabItem>
       </TabControl>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,13,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding SelectedDevice.LastUpdated}" Foreground="#667B90"/>
   <TextBlock Grid.Column="1" Text="{Binding StorageLocation}" Foreground="#8797A9"
    ToolTip="{Binding StorageLocation}" MaxWidth="520"/>
  </Grid>
 </Grid>
</Window>
