<Window x:Class="HostComputer.WpfMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备监控台 · 入门版" Width="820" Height="520"
        MinWidth="640" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="#F6F8FC">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="设备监控台" FontSize="28" FontWeight="SemiBold" Foreground="#142335"/>
        <TextBlock Text="SIMULATED DEVICE  /  127.0.0.1:9000" Foreground="#75869A" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="连接设备" Command="{Binding ConnectCommand}" Padding="16,9" Margin="0,0,10,0"/>
        <Button Content="断开连接" Command="{Binding DisconnectCommand}" Padding="16,9"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#E7EFFB" CornerRadius="8" Padding="16,12" Margin="0,0,0,22">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="连接状态：" FontWeight="SemiBold" Foreground="#183E72"/>
        <TextBlock Text="{Binding Status}" Foreground="#183E72"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" Padding="22" CornerRadius="14">
        <StackPanel>
          <TextBlock Text="温度" Foreground="#69798D" FontSize="16"/>
          <TextBlock Text="{Binding Temperature}" FontWeight="SemiBold" FontSize="31" Margin="0,26,0,8"/>
          <TextBlock Text="℃" Foreground="#7D8B9B"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" Padding="22" CornerRadius="14">
        <StackPanel>
          <TextBlock Text="压力" Foreground="#69798D" FontSize="16"/>
          <TextBlock Text="{Binding Pressure}" FontWeight="SemiBold" FontSize="31" Margin="0,26,0,8"/>
          <TextBlock Text="kPa" Foreground="#7D8B9B"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="White" Padding="22" CornerRadius="14">
        <StackPanel>
          <TextBlock Text="转速" Foreground="#69798D" FontSize="16"/>
          <TextBlock Text="{Binding Rpm}" FontWeight="SemiBold" FontSize="31" Margin="0,26,0,8"/>
          <TextBlock Text="rpm" Foreground="#7D8B9B"/>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding LastUpdated}" Foreground="#7A8A9D" Margin="0,18,0,0"/>
  </Grid>
</Window>
